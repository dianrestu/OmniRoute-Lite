# OmniRoute Lite — Environment Variables
# Copy to .env and edit

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me

# Server
PORT=20128

# ── Low RAM settings (default: 256MB heap) ──
# Increase only if you see OOM errors:
OMNIROUTE_MEMORY_MB=256

# Redis is OPTIONAL — leave empty for in-memory rate limiting
# REDIS_URL=redis://localhost:6379

# Observability (disable to save RAM)
ENABLE_REQUEST_LOGS=false

# Uncomment for ultra-low RAM (128MB heap, may cause GC pauses):
# OMNIROUTE_MEMORY_MB=128
# PROMPT_CACHE_MAX_SIZE=20
# PROMPT_CACHE_MAX_BYTES=524288
# SEMANTIC_CACHE_MAX_SIZE=25
# SEMANTIC_CACHE_MAX_BYTES=1048576
# STREAM_HISTORY_MAX=10
