# ── OmniRoute Lite — Optimized for low-RAM VPS (≤1GB) ─────────────────────
#
# Build on GitHub Actions (7GB RAM available) then pull on your VPS.
# Key optimizations vs stock OmniRoute:
#   - node:22-slim base (smaller than trixie-slim)
#   - --webpack instead of Turbopack (less build memory)
#   - Runtime heap capped at 256MB (vs 1024MB stock)
#   - No Chromium/Playwright (no web-cookie providers)
#   - No CLI tools (Codex, Claude Code, etc.)
#   - No Redis required (in-memory rate limiter fallback)
#
# Build:
#   docker build -f Dockerfile.lite -t omniroute-lite .
#
# ───────────────────────────────────────────────────────────────────────────

# ── Builder ────────────────────────────────────────────────────────────────
FROM node:22-slim AS builder
WORKDIR /app

# Build tools for native module compilation
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY open-sse/package.json ./open-sse/package.json
COPY scripts/build/postinstall.mjs ./scripts/build/postinstall.mjs
COPY scripts/build/postinstallSupport.mjs ./scripts/build/postinstallSupport.mjs
COPY scripts/build/native-binary-compat.mjs ./scripts/build/native-binary-compat.mjs

ENV NPM_CONFIG_LEGACY_PEER_DEPS=true

RUN test -f package-lock.json \
  || (echo "package-lock.json is required for reproducible Docker builds" >&2 && exit 1)

RUN --mount=type=cache,target=/root/.npm \
  npm ci --include=optional --no-audit --no-fund --legacy-peer-deps --ignore-scripts \
  && (cd node_modules/better-sqlite3 \
      && node /usr/local/lib/node_modules/npm/node_modules/node-gyp/bin/node-gyp.js rebuild) \
  && node -e "require('better-sqlite3')(':memory:').close()"

# Use webpack (not Turbopack) — more memory-efficient build
ENV OMNIROUTE_USE_TURBOPACK=0
ENV OMNIROUTE_BASE_PATH=""
ENV OMNIROUTE_MITM_STUB=1

# Build heap: 6GB for webpack. GitHub Actions gives 7GB.
ARG OMNIROUTE_BUILD_MEMORY_MB=6144
ENV NODE_OPTIONS="--max-old-space-size=${OMNIROUTE_BUILD_MEMORY_MB}"

COPY . ./
RUN mkdir -p /app/data \
  && npm run build

# ── Runner ─────────────────────────────────────────────────────────────────
FROM node:22-slim AS runner
WORKDIR /app

LABEL org.opencontainers.image.title="omniroute-lite" \
  org.opencontainers.image.description="OmniRoute Lite — low-RAM AI gateway for VPS (≤1GB)" \
  org.opencontainers.image.source="https://github.com/dianrestu/OmniRoute-Lite"

ENV NODE_ENV=production
ENV PORT=20128
ENV HOSTNAME=0.0.0.0

# ── KEY OPTIMIZATION: 256MB heap (vs 1024MB stock) ──
# V8 will GC aggressively but idle stays under 200MB.
# Override at runtime: docker run -e OMNIROUTE_MEMORY_MB=512
ENV OMNIROUTE_MEMORY_MB=256
ENV NODE_OPTIONS="--max-old-space-size=${OMNIROUTE_MEMORY_MB}"

ENV DATA_DIR=/app/data
RUN mkdir -p /app/data

# Copy standalone bundle from builder
COPY --from=builder /app/.build/next/standalone ./
COPY --from=builder /app/node_modules/better-sqlite3 ./node_modules/better-sqlite3

ENV OMNIROUTE_MIGRATIONS_DIR=/app/migrations

# Healthcheck
COPY --from=builder /app/scripts/dev/healthcheck.mjs ./scripts/dev/healthcheck.mjs

RUN chown -R node:node /app

EXPOSE 20128

USER node

COPY --chmod=755 scripts/check-permissions.sh /app/check-permissions.sh
ENTRYPOINT ["/app/check-permissions.sh"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["node", "scripts/dev/healthcheck.mjs"]

CMD ["node", "scripts/dev/run-standalone.mjs"]
